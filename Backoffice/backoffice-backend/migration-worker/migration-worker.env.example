# Environment file for the migration worker systemd service.
# Copy to /etc/migration-worker.env and chmod 600 (berisi kredensial DB).
#
# DSN harus menunjuk ke DB yang SAMA dengan backend .NET (ConnectionStrings.MyConnection).
# Gunakan libpq DSN format.
MIGRATION_DB_DSN=host=localhost port=5432 dbname=backoffice_db user=postgres password=CHANGE_ME

# Opsional — default-nya sudah cocok dengan struktur /root/migration-khanza.
# MIGRATION_SCRIPT_DIR=/root/migration-khanza/script
# MIGRATION_PYTHON_BIN=/root/migration-khanza/venv/bin/python
# MIGRATION_WORKING_DIR=/root/migration-khanza
# MIGRATION_POLL_SECONDS=5
# MIGRATION_JOB_TIMEOUT=21600
# MIGRATION_MAX_LOG_CHARS=500000
